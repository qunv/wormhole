# Runtime-only secrets. Do not commit real values.
CONTROL_PLANE_API_KEY=
CONTROL_PLANE_TUNNEL_ID=
MCP_AUTH_TOKEN=
AGENT_APPROVAL_TOKEN=
WORMHOLE_MEMORY_SECRET=

# Upstream MCP secrets are referenced by mcpServers.*.envRefs or headerRefs.
# POSTGRES_MCP_DATABASE_URI=postgresql://user:password@127.0.0.1:5432/app
# REMOTE_MCP_AUTHORIZATION=Bearer replace-me

# Optional memory runtime overrides. `wormhole setup` normally stores these
# non-secret values in config.json. agentmemory defaults to 127.0.0.1:3111.
# WORMHOLE_MEMORY_ENABLED=1
# WORMHOLE_MEMORY_PROVIDER=agentmemory
# WORMHOLE_MEMORY_ENDPOINT=http://127.0.0.1:3111
# WORMHOLE_MEMORY_SECRET_ENV=WORMHOLE_MEMORY_SECRET
# WORMHOLE_MEMORY_CAPTURE=selected
# WORMHOLE_MEMORY_TOKEN_BUDGET=1600
# WORMHOLE_MEMORY_AGENT_ID=chatgpt-wormhole
# WORMHOLE_MEMORY_PROJECT_STRATEGY=git-origin
# WORMHOLE_MEMORY_QUEUE_SIZE=128
# WORMHOLE_MEMORY_DELIVERY_TIMEOUT_MS=2000
# WORMHOLE_MEMORY_RETRY_MAX_ATTEMPTS=3
# WORMHOLE_MEMORY_RETRY_BACKOFF_MS=100
# WORMHOLE_MEMORY_HEALTH_CACHE_MS=5000

# Optional runtime overrides.
# AGENT_WORKSPACE=/path/to/repo
# AGENT_MODE=safe
# AGENT_POLICY=balanced
# PORT=8132
